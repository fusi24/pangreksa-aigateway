bin/
*.exe
*.dll
*.so
*.dylib

# ── Go ──────────────────────────────────────────────────────────────────
*.test
*.out
coverage.txt
coverage.html
vendor/

# ── Editor / OS ─────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ── Local Claude agent session state (keep launch.json) ─────────────────
.claude/*
!.claude/launch.json
